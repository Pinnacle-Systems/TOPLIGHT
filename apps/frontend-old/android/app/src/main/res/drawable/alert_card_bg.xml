<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    
    <!-- Card with purple gradient and white border -->
    <corners android:radius="8dp" />
    
    <gradient
        android:startColor="#A08EF2"
        android:endColor="#8E8AF2"
        android:angle="90" />
        
    <stroke
        android:width="1dp"
        android:color="#FFFFFF"
        android:dashWidth="1dp"
        android:dashGap="1dp" />
        
    <padding
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp" />
</shape>