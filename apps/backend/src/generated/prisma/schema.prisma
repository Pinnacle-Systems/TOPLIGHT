generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}



model Settings {
   settingId Int @id @default(autoincrement())
   userId String @unique
   user User @relation(fields: [userId], references: [idCard])
   notification Boolean?
   bioMatrics Boolean?
   compCode String?
}

model NotifyApprovalGroup {
id Int @id @default(autoincrement())
idCard String?
compCode String?
user User[]

}



//Used
model User {
  id Int @id @default(autoincrement())
  userName String @unique
  pic String?
  email String?
  otpEmail String?
  approval String @default("HOD")
  password String?
  idCard String? @unique
  role Role? @relation(fields: [roleId], references: [name], onDelete: SetNull)
  roleId String?
  otp String?
  hod String?
  hr String?
  optionalNotify NotifyApprovalGroup[]
  level String @default("user")
  permission PermissionEntry[]
  verificationOtp String?
  expiresAt DateTime?
  createdAt DateTime? @default(now())
  active Boolean @default(true)
  employeeId Int?
  companies CompanyCode[]
  isAllParty Boolean @default(false)
  isAdmin Boolean @default(false)
  notificationSender Notification[] @relation(name: "sender")
  notificationReceiver Notification[] @relation(name: "receiver")
  fcm String? @default("")
  permissionEntry PermissionEntry[] @relation("PermissionHod")
  permissionEntryCreateUser PermissionEntry[] @relation("create_User")
permissionEntryModifiedUser PermissionEntry[] @relation("modified_User") 
  permissionEntryUser PermissionEntry[] @relation("User")

  leaveEntry LeaveEntry[] @relation("leave_created_by")

  leaveEntryModified LeaveEntry[] @relation("leave_modified_by")

  leaveEntryHod LeaveEntry[] @relation("LeaveHod")

  leaveEntryUser LeaveEntry[] @relation("LeaveUser")

  advanceRequestCreate AdvanceRequest[] @relation("create_User")

  advanceRequestModified AdvanceRequest[] @relation("modified_User")

  advanceRequest AdvanceRequest[] @relation("User")

  onDuty Onduty[] @relation("User")

  ondutyCreate Onduty[] @relation("create_User")

  ondutyModify Onduty[] @relation("modified_User")

  settings Settings[]

}



model Onduty {
     id Int @id @default(autoincrement())
     docId String @unique @db.VarChar(50)
     docDate DateTime @default(now())
     idCard String @db.VarChar(200)
     empName String? @db.VarChar(100)
     hod String?
     hr String?
     startVehicleKm String?
     endVehicleKm String?
     approvalStatus String @default("pending")
     userId String?
     others String?
    userData User? @relation("User", fields: [userId], references: [idCard],onDelete: Cascade) 
     group String @default("onduty")
     inTime String?
     outTime String?
     inOut String @default("IN")
     photo String?
     rejectReason String?
     compCode String
      updatedOn DateTime?
      inLocation String?
     inLatitude String?
     inLongtiude String?
      vehicleNo String?
      bunk String?
      startKm String?
      endKm String?
       outLocation String?
      outLatitude String?
       outLongtiude String?
       toOnduty Boolean @default(false)
       createdBy String?
      createdByUser User? @relation("create_User",fields: [createdBy],references: [idCard],onDelete: Cascade)
      modifiedBy String ?
       modifiedByUser User? @relation("modified_User",fields: [modifiedBy],references: [idCard],onDelete: Cascade)
      rejectBy String? @default("")
      approvedBy String? @default("")
      create Int @default(0)
       update Int @default(0)
       createdAt DateTime @default(now())
       updatedAt DateTime @default(now())
        category Int? @default(1)
       categoryData OndutyMaster? @relation( fields: [category], references: [id])
      //  OndutyMaster OndutyMaster[] @relation("onduty_Category")
}


model AdvanceRequest {
  id Int @id @default(autoincrement())
  docId String @unique @db.VarChar(50)
  docDate DateTime @default(now())
  idCard String @db.VarChar(200)
  fromDate DateTime? @default(now())
  toDate DateTime @default(now())
  empName String @db.VarChar(100)
  finYear String @db.VarChar(10)
  advType String @db.VarChar(30)
  total Float @default(0)
  payType String?
   hod String
    hr String?
   group String @default("Advance")
  isCancelled Boolean @default(false)
  userId String
  preLoan Int? @default(0)
  totalLoan Float @default(0)
  preDue String? @db.VarChar(200) @default("0")
  ins Int @default(0)
  due Int @default(0)
  remark String @db.VarChar(500)
  approvalStatus String @default("pending")
  compCode String
  createdOn DateTime @default(now()) 
  updatedOn DateTime @default(now()) 
  createdBy String
  userData User @relation("User", fields: [userId], references: [idCard],onDelete: Cascade) 
   mobile String?
  create Int @default(0)
  update Int @default(0)
   createdByUser User @relation("create_User",fields: [createdBy],references: [idCard],onDelete: Cascade)
   modifiedBy String
    modifiedByUser User @relation("modified_User",fields: [modifiedBy],references: [idCard],onDelete: Cascade)
    rejectBy String? @default("")
   approvedBy String? @default("")
   category Int @default(1)
   finCode BigInt
   payCode BigInt
   categoryData PermissionMaster @relation("Advance_Category", fields: [category], references: [id])

  @@index([idCard])
  @@index([finYear])
  @@index([approvalStatus])
}


//used 

model CompanyCode {
     id Int @id @default(autoincrement())
    idCard String
    companyCode String
    gComp String?
     user User @relation(fields: [idCard], references: [idCard],onDelete: Cascade)
    companyId String
     @@index([idCard])
}


  model UserLog {
    id Int @id @default(autoincrement())
    user String?
    mobileName String?
    date DateTime @default(now())
    mobileIp String?
    type String
    idCard String?
    compCode String?

  }


model PermissionDocId {
   id Int @id @default(autoincrement())
 count Int

}

model PermissionMaster {
  id Int @id @default(autoincrement())
  name String
  active String
  pType String?
  compCode String @default("null")
  permissionEntry PermissionEntry[] @relation("permision_Category")


  leaveEntry LeaveEntry[] @relation("leave_Category")

  advanceRequest AdvanceRequest[] @relation("Advance_Category")

}

model OndutyMaster {
  id Int @id @default(autoincrement())
  name String
  active String
  compCode String @default("null")
  onDuty Onduty[]
}

model Location {
  id Int @id @default(autoincrement())
  latitude Float
  longitude Float
  timeStamp BigInt
  accuracy Float?
  speed Float?
  bearing Float?
  altitude Float?
  provider String?
  compCode String?
  userId String?
  docId String?
  createdAt DateTime @default(now())

}

model PermissionEntry {
  id Int @id @default(autoincrement())
  createdOn DateTime @default(now())
  createdBy String
  createdByUser User @relation("create_User",fields: [createdBy],references: [idCard],onDelete: Cascade)
   modifiedBy String
   modifiedByUser User @relation("modified_User",fields: [modifiedBy],references: [idCard],onDelete: Cascade)
  modifiedOn DateTime? @default(now())
  group String @default("Permission")
  isCancelled Boolean @default(false)
  userId String
  compCode String
  docId String @unique
  docDate DateTime
  fTime String
  tTime String
  totalHrs String
  mobile String?
  create Int @default(0)
  update Int @default(0)
  approvedBy String? @default("")
  rejectBy String? @default("")
  permissionId String @default(uuid())
  userName String? @default("")
  reason String?
  approvalStatus String @default("pending")
  hod String
   hr String?
  category Int @default(1)
 categoryData PermissionMaster @relation("permision_Category", fields: [category], references: [id])
  hodId User @relation("PermissionHod", fields: [hod], references: [idCard],onDelete: Cascade)
  userData User @relation("User", fields: [userId], references: [idCard],onDelete: Cascade)
   user User[]
 
}
model Trackers {
  id Int @id @default(autoincrement()) 
  userId String? @unique
  isLive Boolean @default(false)
  compCode String?
  docId String? @unique
  empName String?
  endDocId String?
}


model Vechilekm {
  id Int @id @default(autoincrement()) 
  vehicleNo String? @unique
  compCode String?
  km String?
}


  model LeaveEntry {
  id Int @id @default(autoincrement())
  createdOn DateTime @default(now())
  createdBy String
  createdByUser User @relation("leave_created_by", fields: [createdBy], references: [idCard],onDelete: Cascade)
  modifiedBy String
  modifiedByUser User @relation("leave_modified_by", fields: [modifiedBy], references: [idCard],onDelete: Cascade)
  modifiedOn DateTime? @default(now())
  isCancelled Boolean @default(false)
  userId String
  compCode String
  group String @default("Leave")
  finYear String
  docId String @unique
  docDate DateTime
  fromDate DateTime
  toDate DateTime
  totalDays Float
   hr String?
  lType String?
  flType String?
  tlType String?
  mobile String?
  reason String?
  approvalStatus String @default("pending")
  approvedBy String? @default("")
  rejectBy String? @default("")
  hod String
  hodId User @relation("LeaveHod", fields: [hod], references: [idCard],onDelete: Cascade)
   userData User @relation("LeaveUser", fields: [userId], references: [idCard],onDelete: Cascade)
  leaveId String @default(uuid())
   create Int @default(0)
   empName String?
  update Int @default(0)
  categoryData PermissionMaster @relation("leave_Category", fields: [category], references: [id])
  category Int @default(1)
}




model Role {
  id Int @id @default(autoincrement())
  name String @unique  
  compCode String @default("")
  user User[]
  roleOnPage RoleOnPage[] @relation("RoleToRoleOnPage")
  active String @default("Yes")
  defaultRole Boolean @default(false)

}

model RoleOnPage {
  id Int @id @default(autoincrement())
  role Role @relation("RoleToRoleOnPage",fields: [roleName], references: [name], onDelete: Cascade)
  roleId Int?
  roleName String
  read Boolean @default(false)
  create Boolean @default(false)
  edit Boolean @default(false)
  link String
  delete Boolean @default(false)
  isDefault Boolean @default(false)

}






model Notification {
  id Int @id @default(autoincrement())
  costingId Int
  sender User @relation("sender", fields: [senderId], references: [id])
  senderId Int
  receiver User? @relation("receiver", fields: [receiverId], references: [id])
  receiverId Int?
  type String?
  message String?
  isRead Boolean @default(false)

}

